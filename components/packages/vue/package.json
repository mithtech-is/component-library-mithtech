{
  "name": "@mithtech-bengaluru/tonaldepth-vue",
  "version": "0.1.0-alpha.0",
  "description": "Typed Vue components for the TonalDepth design system",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": ["*.css"],
  "files": ["dist", "README.md"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.json && node scripts/copy-css.mjs",
    "test": "vitest run --pool=forks --maxWorkers=1"
  },
  "dependencies": {
    "@mithtech-bengaluru/tonaldepth-core": "0.1.0-alpha.0"
  },
  "peerDependencies": { "vue": "^3.5.0" },
  "publishConfig": { "registry": "https://npm.po5.in", "access": "restricted" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mithtech-Bengaluru/tonaldepth.git",
    "directory": "packages/vue"
  }
}
