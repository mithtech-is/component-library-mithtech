{
  "name": "tonaldepth-workspace",
  "version": "0.0.0-private",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "description": "Private TonalDepth multi-platform design-system workspace",
  "scripts": {
    "audit:baseline": "python tooling/audit/audit_html.py",
    "tokens:import": "python tooling/tokens/import_baseline.py",
    "tokens:check": "python tooling/tokens/import_baseline.py --check",
    "tokens:build": "python tooling/tokens/build.py",
    "tokens:build-native": "python tooling/tokens/build_native.py",
    "test:native-tokens": "python -m unittest tooling.tests.test_native_tokens",
    "test:core": "python -m unittest discover -s tooling/tests -p test_*.py",
    "build:react": "pnpm --filter @mithtech-bengaluru/tonaldepth-react build",
    "dev:docs": "pnpm generate && pnpm --filter tonaldepth-docs dev",
    "build:docs": "pnpm generate && pnpm build:react && pnpm registry:check && pnpm --filter tonaldepth-docs build",
    "registry:build": "node tooling/registry/build.mjs",
    "test:react": "pnpm --filter @mithtech-bengaluru/tonaldepth-react test",
    "build:vue": "pnpm --filter @mithtech-bengaluru/tonaldepth-vue build",
    "build:nativewind": "pnpm --filter @mithtech-bengaluru/tonaldepth-nativewind build",
    "build:react-native": "pnpm --filter @mithtech-bengaluru/tonaldepth-react-native build",
    "test:react-native": "pnpm --filter @mithtech-bengaluru/tonaldepth-react-native test",
    "test:vue": "pnpm --filter @mithtech-bengaluru/tonaldepth-vue test",
    "test:vue-consumers": "python tooling/tests/test_vue_consumers.py",
    "build:react-consumers": "pnpm --filter tonaldepth-react-catalog build && pnpm --filter tonaldepth-next-consumer build",
    "test:react-consumers": "python tooling/tests/test_react_consumers.py",
    "registry:generate": "node tooling/registry/generate.mjs",
    "brands:build": "node tooling/brands/build.mjs",
    "docs:props": "node tooling/docs/props.mjs",
    "generate": "pnpm tokens:build && pnpm tokens:build-native && pnpm brands:build && pnpm registry:generate && pnpm docs:props && pnpm registry:build",
    "registry:check": "pnpm tokens:check && node tooling/registry/generate.mjs --check && node tooling/registry/css-parity.mjs && node tooling/brands/build.mjs --check"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "@types/react-test-renderer": "19.1.0",
    "@vue/server-renderer": "3.5.41",
    "@vue/test-utils": "2.4.11",
    "axe-core": "4.13.0",
    "jsdom": "30.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-native": "0.87.0",
    "react-test-renderer": "19.2.8",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "vue": "3.5.41"
  }
}
