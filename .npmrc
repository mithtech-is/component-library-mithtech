# All packages — ours and the npmjs cache — come from the private registry on po5.
# Verdaccio proxies and caches registry.npmjs.org, so this is the only registry
# any consumer needs to know about.
registry=https://npm.po5.in/
@mithtech-bengaluru:registry=https://npm.po5.in/
always-auth=true

# The auth token is NOT stored here. Run `npm login --registry https://npm.po5.in/`
# once; npm writes the token to ~/.npmrc, which is outside the repo.
